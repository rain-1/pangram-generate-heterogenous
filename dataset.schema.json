{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:generate-heterogeneous:dataset:1.0",
  "title": "Heterogeneous document with exact construction provenance",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "split",
    "offset_unit",
    "end_exclusive",
    "label_definition",
    "text",
    "text_sha256",
    "spans",
    "source",
    "replacements",
    "construction",
    "ai_fraction_chars"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "offset_unit": {
      "const": "unicode_codepoint"
    },
    "end_exclusive": {
      "const": true
    },
    "label_definition": {
      "type": "object",
      "required": [
        "human",
        "ai"
      ],
      "properties": {
        "human": {
          "type": "string"
        },
        "ai": {
          "type": "string"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "$ref": "#/$defs/hash"
    },
    "ai_fraction_chars": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "replacements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacement"
      }
    },
    "construction": {
      "type": "object",
      "required": [
        "plan_id",
        "kind"
      ],
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/hash"
        },
        "kind": {
          "enum": [
            "mixed",
            "human_control"
          ]
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "group_id",
        "reference",
        "provenance",
        "human_verified",
        "text",
        "sha256",
        "normalized_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "human_verified": {
          "type": "boolean"
        },
        "authorship": {
          "type": "string"
        },
        "human_origin_basis": {
          "type": "object",
          "minProperties": 1
        },
        "author_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "normalized_sha256": {
          "$ref": "#/$defs/hash"
        },
        "language": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "human_verified": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "authorship",
              "human_origin_basis"
            ],
            "properties": {
              "authorship": {
                "const": "human_candidate"
              }
            }
          }
        }
      ]
    },
    "non_ai_author": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "non_ai"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "backend",
        "kind",
        "requested_model",
        "reported_model",
        "family",
        "revision",
        "provider",
        "request_id",
        "sampling",
        "generated_at",
        "finish_reason",
        "prompt_sha256",
        "usage",
        "metadata"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "codex",
            "claude",
            "openrouter",
            "openai-compatible",
            "claude-web"
          ]
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "reported_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampling": {
          "type": "object"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "finish_reason": {
          "type": "string"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/hash"
        },
        "usage": {
          "type": [
            "object",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "ai_author": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "ai"
            }
          }
        }
      ]
    },
    "span": {
      "type": "object",
      "required": [
        "start",
        "end",
        "label",
        "source_start",
        "source_end",
        "author",
        "replacement_id"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/offset"
        },
        "end": {
          "$ref": "#/$defs/offset"
        },
        "label": {
          "enum": [
            "human",
            "ai"
          ]
        },
        "source_start": {
          "$ref": "#/$defs/offset"
        },
        "source_end": {
          "$ref": "#/$defs/offset"
        },
        "author": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_ai_author"
            },
            {
              "$ref": "#/$defs/ai_author"
            }
          ]
        },
        "replacement_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "human"
              }
            }
          },
          "then": {
            "properties": {
              "author": {
                "$ref": "#/$defs/non_ai_author"
              },
              "replacement_id": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "author": {
                "$ref": "#/$defs/ai_author"
              },
              "replacement_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "completion": {
      "type": "object",
      "required": [
        "text",
        "provenance",
        "prompt",
        "quality",
        "quality_attempt",
        "rejected_attempts",
        "cache_key"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "type": "object"
        },
        "quality_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "rejected_attempts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cache_key": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "replacement": {
      "type": "object",
      "required": [
        "id",
        "source_start",
        "source_end",
        "source_units",
        "summary",
        "summarization",
        "generated_text",
        "generation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_start": {
          "$ref": "#/$defs/offset"
        },
        "source_end": {
          "$ref": "#/$defs/offset"
        },
        "source_units": {
          "type": "integer",
          "minimum": 1
        },
        "source_words": {
          "type": "integer",
          "minimum": 1
        },
        "source_paragraphs": {
          "type": "integer",
          "minimum": 1
        },
        "source_sentences": {
          "type": "integer",
          "minimum": 1
        },
        "source_characters": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "summarization": {
          "$ref": "#/$defs/completion"
        },
        "generated_text": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "$ref": "#/$defs/completion"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "human_verified": {
                "const": false
              }
            },
            "required": [
              "human_verified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "construction": {
            "required": [
              "source_origin_policy"
            ],
            "properties": {
              "source_origin_policy": {
                "const": "documented_candidates"
              }
            }
          },
          "label_definition": {
            "properties": {
              "human": {
                "pattern": "candidate"
              }
            }
          }
        }
      }
    }
  ]
}
